# Copy to .env (git-ignored). Every value below has a production default, so an empty .env works;
# they exist for pointing at a local dev stack. All names are CHUDP_-prefixed so that variables a
# shell exports for the Verys dev stack itself (VERYS_CLIENT_ID, AUTH_URL, ...) cannot leak in.

# chud-money API. GET /{market} is public; the data stream needs a bearer token.
# CHUDP_API_BASE=https://api.chud-money.mcmlln.dev
# CHUDP_MARKET=btc-15m
# CHUDP_API_TIMEOUT_S=120                  # per-read timeout on the stream (keep-alives every 15 s)

# Verys, the auth server in front of the API. `chudp auth login` writes CHUDP_AUTH_FILE
# (chmod 600, git-ignored): a rotating refresh token plus the 60-day Verys browser cookie.
# Treat that file as a password.
# CHUDP_VERYS_URL=https://api.verys.mcmlln.dev
# CHUDP_VERYS_CLIENT_ID=99e6d288-fab8-4e18-a4df-ada501e18fce   # the SPA's public PKCE client
# CHUDP_API_AUDIENCE=99e6d288-fab8-4e18-a4df-ada501e18fce      # token-exchange audience (same client)
# CHUDP_VERYS_REDIRECT_URI=https://chud-money.mcmlln.dev/auth/callback   # must be registered verbatim
# CHUDP_AUTH_FILE=.auth/session.json

# Optional overrides
# CHUDP_DATA_DIR=data
# CHUDP_DEVICE=cpu          # cpu | mps | cuda (ROCm also shows up as cuda)
# HF_HOME=models            # HuggingFace cache; the 3.0 checkpoint is ~1.3 GB
# HF_TOKEN=                 # not needed, the model repo is public
