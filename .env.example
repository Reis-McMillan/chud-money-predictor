# Copy to .env (git-ignored). `make creds` fills QDB_PASSWORD from the cluster automatically.
#
# On a machine without kubeconfig (e.g. the MI300X box) paste the password by hand:
# it is the Oracle Vault secret `qdb-password`, also readable with
#   kubectl get secret -n questdb questdb-secrets -o jsonpath='{.data.DB_PASS}' | base64 -d

# QuestDB HTTP endpoint as seen from this machine. With `scripts/port-forward.sh start`
# the cluster service questdb.questdb.svc:9000 is exposed on localhost:19000.
QDB_HOST=127.0.0.1
QDB_PORT=19000
QDB_USER=admin
QDB_PASSWORD=

# Optional overrides
# CHUDP_DATA_DIR=data
# CHUDP_DEVICE=cpu          # cpu | mps | cuda (ROCm also shows up as cuda)
# HF_HOME=models            # HuggingFace cache; the 3.0 checkpoint is ~1.3 GB
# HF_TOKEN=                 # not needed, the model repo is public
